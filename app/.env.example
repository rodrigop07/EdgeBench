# ────────────────────────────────────────────────────────────────────────────
# EdgeBench Backend — Variáveis de Ambiente
# Copie este arquivo para `.env` e ajuste os valores conforme seu ambiente.
# ────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edgebench
POSTGRES_USER=edgebench_user
POSTGRES_PASSWORD=edgebench_pass

# Pool de conexões SQLAlchemy
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Broker MQTT (Mosquitto) ───────────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=edgebench_backend
MQTT_KEEPALIVE=60
MQTT_TOPIC_FILTER=fabrica/bancada_+/producao
MQTT_QOS=1
MQTT_RECONNECT_MIN=1
MQTT_RECONNECT_MAX=30

# ── Aplicação ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
REPORTS_DIR=reports

# ── Integração Google Sheets/Drive ───────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=google-credentials.json
GOOGLE_DRIVE_FOLDER_ID=1S1lVlPWxJTHy2aCeyp8cuY9oeLME5fYE
